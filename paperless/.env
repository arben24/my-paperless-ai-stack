TZ=America/Chicago
PAPERLESS_REDIS=redis://redis:6379
PAPERLESS_DBHOST=postgres
PAPERLESS_DBNAME=paperless #if you change this, be sure to also change it in the postgres .env
PAPERLESS_DBUSER=paperless # if you change this, be sure to also change it in the postgres .env
PAPERLESS_DBPASS=paperless # if you change this, be sure to also change it in the postgres .env (You should change this for production use)
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998

# Consume folder: poll instead of native file events. On a Windows host the bind mount
# does not reliably deliver inotify events, so new files may go unnoticed until restart.
PAPERLESS_CONSUMER_POLLING_INTERVAL=10

# Required since paperless-ngx 3.0 — unique per install, keep secret.
PAPERLESS_SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token-urlsafe-64

# --- Native AI (paperless-ngx 3.x built-in LLM features) ---
# Powers AI-suggested title/tags/correspondent/type and the document chat.
PAPERLESS_AI_ENABLED=1
PAPERLESS_AI_LLM_BACKEND=ollama
PAPERLESS_AI_LLM_ENDPOINT=http://ollama:11434
PAPERLESS_AI_LLM_MODEL=gemma4:e4b
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=English
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300
# ollama runs on the internal compose network, so internal endpoints must be allowed
PAPERLESS_AI_LLM_ALLOW_INTERNAL_ENDPOINTS=1
# Embeddings for the LLM/RAG index (must be pulled in ollama)
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
PAPERLESS_AI_LLM_EMBEDDING_MODEL=embeddinggemma
PAPERLESS_AI_LLM_EMBEDDING_ENDPOINT=http://ollama:11434
# Nightly rebuild of the LLM index
PAPERLESS_LLM_INDEX_TASK_CRON=10 2 * * *
