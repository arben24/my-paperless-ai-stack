PAPERLESS_BASE_URL: "http://paperless:8000"
PAPERLESS_API_TOKEN: some-token  # change to your paperless API token
# PAPERLESS_PUBLIC_URL: "http://paperless.mydomain.com" # Optional

LLM_PROVIDER: "ollama"
LLM_MODEL: "gemma3:4b" # teilt sich das Modell mit paperless-ngx -> kein zusaetzliches VRAM
OLLAMA_HOST: "http://host.docker.internal:11434"
OLLAMA_CONTEXT_LENGTH: "8192" # Sets Ollama NumCtx (context window)
TOKEN_LIMIT: 1000 # Recommended for smaller models

LLM_LANGUAGE: "German" # Optional, default: English

OCR_PROVIDER: "llm" # zurueck auf Ollama-Vision (glm-ocr) - lieferte die besseren Ergebnisse
VISION_LLM_PROVIDER: "ollama" # openai, ollama, mistral, or anthropic
VISION_LLM_MODEL: "maternion/LightOnOCR-2"

AUTO_OCR_TAG: "paperless-gpt-ocr-auto"
AUTO_TAG: "paperless-gpt-auto"
MANUAL_TAG: "paperless-gpt-manual"
# durchsuchbares PDF und braucht dafuer hOCR. Ollama-Modelle liefern kein hOCR
# ("hocr_capable": false), nur azure / google_docai / docling / mistral_ocr.
# Steht auf true, damit es sofort greift, falls du auf docling wechselst.

LOG_LEVEL: "DEBUG" 

# For a full list of configuration options, see the documentation at: https://github.com/icereed/paperless-gpt?tab=readme-ov-file#docker-compose

# --- OCR-Geschwindigkeit (gemessen am 2026-09-04) ---
# 600 DPI ergab 4961x7016 px = 34,8 MP pro Seite. 300 DPI viertelt die Pixelzahl
# bei identischer Trefferquote auf Betraegen und Adressen.
IMAGE_MAX_RENDER_DPI: "300"
# Deterministische Ausgabe. Verhindert das Ausufern, das bei Dokument 38 Seite 1
# den Kontext gesprengt und ein leeres Ergebnis erzeugt hat.
VISION_LLM_TEMPERATURE: "0"
# Original bleibt erhalten (deine Entscheidung 2026-09-05). "true" wuerde es loeschen.

# --- Docling (INAKTIV, solange OCR_PROVIDER=llm) ---
# Der Container laeuft weiter; zum Zurueckschalten OCR_PROVIDER auf "docling"
# und OCR_PROCESS_MODE auf "whole_pdf" setzen.
DOCLING_URL: "http://docling:5001"
# Gemessen 2026-09-05 an Dok 14 (1 Seite):
#   standard + rapidocr :  7s, gleiche Trefferquote
#   vlm (granitedocling): 42s, gleiche Trefferquote, Muell am Seitenende
DOCLING_OCR_PIPELINE: "standard"
# rapidocr, weil genau dessen Modelle vorgeladen sind (easyocr waere ein weiterer Download).
DOCLING_OCR_ENGINE: "rapidocr"
# "image" gehoert zum llm-Provider: nur so greift IMAGE_MAX_RENDER_DPI.
# ("whole_pdf" war fuer Docling gesetzt.)
OCR_PROCESS_MODE: "image"
# "embedded" haengt jede Seite als Base64-PNG in den Dokumenttext (Dok 14 wurde
# dadurch 501.624 Zeichen gross). "placeholder" liefert nur den Text.
DOCLING_IMAGE_EXPORT_MODE: "placeholder"
# glm-ocr meldet keine "thinking"-Faehigkeit; explizit abschalten.
OLLAMA_THINK: "false"
# Ohne Obergrenze lieferte glm-ocr ueber paperless-gpt content_length=0.
VISION_LLM_MAX_TOKENS: "8192"


# --- OCR-Ergebnis nach Paperless zurueckbringen ---
# Laut offizieller Doku laesst sich ein bestehendes Dokument ueber die
# Paperless-API nicht aktualisieren. Der Upload als NEUES Dokument ist der
# einzige Weg, den VLM-Text in Paperless sichtbar zu machen.
# PDF_UPLOAD: "true"
# Titel, Tags, Korrespondent und Erstelldatum aufs neue Dokument uebertragen.
# PDF_COPY_METADATA: "true"
# Original NICHT loeschen. "true" ist laut Doku unwiderruflich.
# PDF_REPLACE: "false"

# Der ocr-complete-Tag ist die Schleifenbremse: das hochgeladene Dokument
# erbt ihn und wird dadurch nicht erneut zur OCR eingereiht.
PDF_OCR_TAGGING: "true"
PDF_OCR_COMPLETE_TAG: "paperless-gpt-auto"

# 0 = alle Seiten. Wichtig: bei einem Limit unterhalb der echten Seitenzahl
# ueberspringt paperless-gpt die PDF-Erzeugung komplett (Page Count Check).
OCR_LIMIT_PAGES: "0"
